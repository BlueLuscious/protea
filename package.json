{
  "name": "protea",
  "description": "Contributor infrastructure for Protea, a standalone UI component library project.",
  "private": true,
  "type": "module",
  "author": "BlueLuscious",
  "license": "ISC",
  "homepage": "https://github.com/BlueLuscious/protea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/protea.git"
  },
  "bugs": {
    "url": "https://github.com/BlueLuscious/protea/issues"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "format": "prettier --write README.md \"docs/en/**/*.md\" package.json tsconfig.base.json eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check README.md \"docs/en/**/*.md\" package.json tsconfig.base.json eslint.config.mjs .prettierrc.json",
    "lint": "eslint eslint.config.mjs --max-warnings 0",
    "verify": "pnpm run lint && pnpm run format:check"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
