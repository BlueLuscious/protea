{
  "name": "protea",
  "description": "Contributor infrastructure for Protea, a standalone UI component library project.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "author": "BlueLuscious",
  "license": "ISC",
  "homepage": "https://github.com/BlueLuscious/protea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/protea.git"
  },
  "bugs": {
    "url": "https://github.com/BlueLuscious/protea/issues"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "format": "prettier --write package.json packages/*/package.json .prettierrc.json eslint.config.mjs",
    "format:check": "prettier --check package.json packages/*/package.json .prettierrc.json eslint.config.mjs",
    "lint": "eslint packages tooling tests eslint.config.mjs \"design/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --project packages/core/tsconfig.json",
    "typecheck:design": "tsc --project design/tsconfig.json",
    "build": "node tooling/workspace/build-core.mjs",
    "test:tooling": "node --test tests/tooling/core-build.test.mjs",
    "test:runtime": "node --test tests/runtime/component-scope.test.mjs",
    "test:consumer": "node --test tests/distribution/core-package.test.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:design && pnpm run format:check && pnpm run test:tooling && pnpm run test:runtime && pnpm run test:consumer"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
