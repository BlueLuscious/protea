{
  "name": "@luscious-garden/protea-components",
  "version": "0.0.0",
  "description": "Portable component families and reusable capabilities for Protea.",
  "private": true,
  "type": "module",
  "license": "ISC",
  "author": "BlueLuscious",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueLuscious/protea.git",
    "directory": "packages/components"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/api/capabilities/index.d.ts",
      "import": "./dist/api/capabilities/index.js",
      "default": "./dist/api/capabilities/index.js"
    },
    "./capabilities/*": {
      "types": "./dist/api/capabilities/*.api.d.ts",
      "import": "./dist/api/capabilities/*.api.js",
      "default": "./dist/api/capabilities/*.api.js"
    },
    "./definitions": null,
    "./definitions/*": {
      "types": "./dist/components/*/definitions/*.definition.d.ts",
      "import": "./dist/components/*/definitions/*.definition.js",
      "default": "./dist/components/*/definitions/*.definition.js"
    },
    "./*": {
      "types": "./dist/api/families/*.api.d.ts",
      "import": "./dist/api/families/*.api.js",
      "default": "./dist/api/families/*.api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tooling/workspace/build-components.mjs"
  },
  "dependencies": {
    "@luscious-garden/protea-core": "workspace:*"
  }
}
